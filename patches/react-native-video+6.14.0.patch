+  // Seek to 200s (or with tolerance on iOS)
+  videoRef.current.seek(200);
+  videoRef.current.seek(200, 10);
+};
+
+return (
+  <Video
+    ref={videoRef}
+    source={{ uri: 'https://www.w3schools.com/html/mov_bbb.mp4' }}
+  />
+);
+```
